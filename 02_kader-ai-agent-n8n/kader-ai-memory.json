    {
      "id": "8a08a81d-deb4-4814-9b94-a93b906460da",
      "name": "Préparer la note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\nconst out = [];\nfor (const item of $input.all()) {\n  const titre = String(item.json.titre || 'Note technique').trim();\n  const categorie = String(item.json.categorie || 'general').trim();\n  const contenu = String(item.json.contenu || '').trim();\n  if (!contenu) throw new Error('Le champ contenu est vide : rien a enregistrer.');\n  const now = new Date();\n  const date = now.toISOString().slice(0, 10);\n  const slug = titre.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60) || 'note';\n  const fileName = date + '_' + slug + '.md';\n  const md = '# ' + titre + '\\n\\n- Categorie : ' + categorie + '\\n- Date : ' + now.toISOString() + '\\n\\n' + contenu + '\\n';\n  out.push({\n    json: { fileName, titre, categorie },\n    binary: { data: { data: Buffer.from(md, 'utf8').toString('base64'), mimeType: 'text/markdown', fileName } },\n  });\n}\nreturn out;\n"
      }
    },
    {
      "id": "0a7e537a-cd9a-4c19-951e-d52b05382362",
      "name": "Écrire dans KADER_AI_MEMORY",
